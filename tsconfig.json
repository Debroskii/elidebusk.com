{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    // "src/declarations.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "bundler",
    "paths": {
      "@splidejs/react-splide": ["./node_modules/@splidejs/splide"]
    }
  }
}